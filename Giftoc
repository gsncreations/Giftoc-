            document.getElementById('canvasWidth').value = 240;
            document.getElementById('canvasHeight').value = 320;
            document.getElementById('drawMode').value = 'horizontal_bytes';
            document.getElementById('invertColors').checked = false;
        }
        updateStats();
        updatePreview();
    }

    function sanitizeFileName(fileName) {
        fileName = fileName.replace(/\.gif$/i, '');
        fileName = fileName.replace(/[^a-zA-Z0-9_]/g, '_');
        if (/^\d/.test(fileName)) {
            fileName = '_' + fileName;
        }
        return fileName;
    }

    function handleGifUpload(event) {
        const file = event.target.files[0];
        if (!file || !file.type.includes('gif')) {
            alert('Please select a GIF file!');
            return;
        }
        
        resetPreview();
        const variableName = sanitizeFileName(file.name);
        document.getElementById('variableName').value = variableName;
        
        const previewSection = document.getElementById('previewSection');
        if (previewSection) previewSection.style.display = 'block';
        
        const fileURL = URL.createObjectURL(file);
        
        const framesPreviewDiv = document.getElementById('framesPreview');
        if (framesPreviewDiv) {
            framesPreviewDiv.innerHTML = '<div class="spinner-border" style="color: var(--accent-teal);" role="status"><span class="visually-hidden">Loading frames...</span></div>';
        }
        
        let existingHiddenGif = document.getElementById('hiddenGifForLib');
        if (existingHiddenGif) existingHiddenGif.remove();
        
        const hiddenGif = document.createElement('img');
        hiddenGif.id = 'hiddenGifForLib';
        hiddenGif.style.position = 'absolute';
        hiddenGif.style.left = '-9999px';
        hiddenGif.setAttribute('rel:animated_src', fileURL);
        hiddenGif.setAttribute('rel:auto_play', '0');
        document.body.appendChild(hiddenGif);
        
        try {
            gifPlayer = new SuperGif({ gif: hiddenGif, auto_play: false });
            
            gifPlayer.load(function() {
                URL.revokeObjectURL(fileURL);
                const numFrames = gifPlayer.get_length();
                
                if (numFrames === 0) {
                    alert('Cannot read frames from this GIF file.');
                    resetPreview();
                    return;
                }
                
                gifFrames = [];
                frameDelays = [];
                
                for (let i = 0; i < numFrames; i++) {
                    gifPlayer.move_to(i);
                    const canvas = gifPlayer.get_canvas();
                    const frameCopy = document.createElement('canvas');
                    frameCopy.width = canvas.width;
                    frameCopy.height = canvas.height;
                    frameCopy.getContext('2d').drawImage(canvas, 0, 0);
                    gifFrames.push(frameCopy);
                    frameDelays.push(100);
                }
                
                currentFrameIndex = 0;
                updateFrameCounter();
                updatePreview();
                
                // Update stats
                document.getElementById('frameCount').textContent = numFrames;
                const fileSizeKB = (file.size / 1024).toFixed(1);
                document.getElementById('fileSize').textContent = `${fileSizeKB} KB`;
                
                const prevFrameBtn = document.getElementById('prevFrame');
                const nextFrameBtn = document.getElementById('nextFrame');
                const playPauseBtn = document.getElementById('playPause');
                const convertButton = document.getElementById('convertButton');
                
                if (prevFrameBtn) prevFrameBtn.disabled = (numFrames <= 1);
                if (nextFrameBtn) nextFrameBtn.disabled = (numFrames <= 1);
                if (playPauseBtn) {
                    playPauseBtn.disabled = (numFrames <= 1);
                    playPauseBtn.innerHTML = '<i class="bi bi-play-fill"></i> Play';
                }
                if (convertButton) convertButton.disabled = false;
            });
        } catch (error) {
            console.error('Error processing GIF:', error);
            alert('Cannot process GIF file. Please try another file.');
            URL.revokeObjectURL(fileURL);
            resetPreview();
        } finally {
            event.target.value = null;
        }
    }

    function loadFromUrl() {
        const urlInput = document.getElementById('gifUrlInput');
        const url = urlInput.value.trim();
        
        if (!url) {
            alert('Please enter a GIF URL');
            return;
        }
        
        resetPreview();
        const previewSection = document.getElementById('previewSection');
        const framesPreviewDiv = document.getElementById('framesPreview');
        
        if (previewSection) previewSection.style.display = 'block';
        if (framesPreviewDiv) {
            framesPreviewDiv.innerHTML = '<div class="spinner-border" style="color: var(--accent-teal);" role="status"><span class="visually-hidden">Loading GIF...</span></div>';
        }
        
        const urlParts = url.split('/');
        const fileName = urlParts[urlParts.length - 1].replace(/\.gif$/i, '');
        const variableName = sanitizeFileName(fileName);
        document.getElementById('variableName').value = variableName;
        
        let existingHiddenGif = document.getElementById('hiddenGifForLib');
        if (existingHiddenGif) existingHiddenGif.remove();
        
        const hiddenGif = document.createElement('img');
        hiddenGif.id = 'hiddenGifForLib';
        hiddenGif.style.position = 'absolute';
        hiddenGif.style.left = '-9999px';
        hiddenGif.setAttribute('rel:animated_src', url);
        hiddenGif.setAttribute('rel:auto_play', '0');
        document.body.appendChild(hiddenGif);
        
        try {
            gifPlayer = new SuperGif({ gif: hiddenGif, auto_play: false });
            
            gifPlayer.load(function() {
                const numFrames = gifPlayer.get_length();
                
                if (numFrames === 0) {
                    throw new Error('No frames found in GIF');
                }
                
                gifFrames = [];
                frameDelays = [];
                
                for (let i = 0; i < numFrames; i++) {
                    gifPlayer.move_to(i);
                    const canvas = gifPlayer.get_canvas();
                    const frameCopy = document.createElement('canvas');
                    frameCopy.width = canvas.width;
                    frameCopy.height = canvas.height;
                    frameCopy.getContext('2d').drawImage(canvas, 0, 0);
                    gifFrames.push(frameCopy);
                    frameDelays.push(100);
                }
                
                currentFrameIndex = 0;
                updateFrameCounter();
                updatePreview();
                
                // Update stats
                document.getElementById('frameCount').textContent = numFrames;
                
                const prevFrameBtn = document.getElementById('prevFrame');
                const nextFrameBtn = document.getElementById('nextFrame');
                const playPauseBtn = document.getElementById('playPause');
                const convertButton = document.getElementById('convertButton');
                
                if (prevFrameBtn) prevFrameBtn.disabled = (numFrames <= 1);
                if (nextFrameBtn) nextFrameBtn.disabled = (numFrames <= 1);
                if (playPauseBtn) {
                    playPauseBtn.disabled = (numFrames <= 1);
                    playPauseBtn.innerHTML = '<i class="bi bi-play-fill"></i> Play';
                }
                if (convertButton) convertButton.disabled = false;
            });
        } catch (error) {
            console.error('Error loading GIF:', error);
            alert('Cannot load GIF from URL: ' + error.message);
            if (framesPreviewDiv) {
                framesPreviewDiv.innerHTML = '<p class="text-danger">Error loading GIF</p>';
            }
            document.getElementById('convertButton').disabled = true;
        }
    }

    function updateFrameCounter() {
        const counter = document.getElementById('frameCounter');
        counter.textContent = `Frame: ${currentFrameIndex + 1}/${gifFrames.length}`;
    }

    function showPreviousFrame() {
        if (gifFrames.length === 0) return;
        currentFrameIndex = (currentFrameIndex - 1 + gifFrames.length) % gifFrames.length;
        updateFrameCounter();
        updatePreview();
    }

    function showNextFrame() {
        if (gifFrames.length === 0) return;
        currentFrameIndex = (currentFrameIndex + 1) % gifFrames.length;
        updateFrameCounter();
        updatePreview();
    }

    function togglePlayPause() {
        if (gifFrames.length === 0) return;
        
        isPlaying = !isPlaying;
        const playPauseButton = document.getElementById('playPause');
        
        if (isPlaying) {
            playPauseButton.innerHTML = '<i class="bi bi-pause-fill"></i> Pause';
            playGif();
        } else {
            playPauseButton.innerHTML = '<i class="bi bi-play-fill"></i> Play';
            clearTimeout(playInterval);
        }
    }

    function playGif() {
        clearTimeout(playInterval);
        
        function showNextFrameWithDelay() {
            showNextFrame();
            const delay = frameDelays[currentFrameIndex] || 100;
            playInterval = setTimeout(showNextFrameWithDelay, delay);
        }
        
        showNextFrameWithDelay();
    }

    function updatePreview() {
        if (gifFrames.length === 0 || !document.getElementById('previewEnabled').checked) return;
        
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');
        const width = parseInt(document.getElementById('canvasWidth').value);
        const height = parseInt(document.getElementById('canvasHeight').value);
        const threshold = parseInt(document.getElementById('threshold').value);
        const invertColors = document.getElementById('invertColors').checked;
        const scaleMode = document.getElementById('scaleMode').value;
        const customScale = parseFloat(document.getElementById('customScale').value) || 1;
        const flipH = document.getElementById('flipHorizontal').checked;
        const flipV = document.getElementById('flipVertical').checked;
        const rotation = parseInt(document.getElementById('rotation').value);
        
        canvas.width = width;
        canvas.height = height;
        
        const frame = gifFrames[currentFrameIndex];
        if (!frame) return;
        
        let scale = 1;
        let offsetX = 0;
        let offsetY = 0;
        
        if (scaleMode === 'fit') {
            const scaleX = width / frame.width;
            const scaleY = height / frame.height;
            scale = Math.min(scaleX, scaleY);
        } else if (scaleMode === 'fit_width') {
            scale = width / frame.width;
        } else if (scaleMode === 'fit_height') {
            scale = height / frame.height;
        } else if (scaleMode === 'custom') {
            scale = customScale;
        }
        
        const scaledWidth = frame.width * scale;
        const scaledHeight = frame.height * scale;
        offsetX = (width - scaledWidth) / 2;
        offsetY = (height - scaledHeight) / 2;
        
        ctx.save();
        ctx.translate(width/2, height/2);
        if (rotation) ctx.rotate(rotation * Math.PI / 180);
        if (flipH) ctx.scale(-1, 1);
        if (flipV) ctx.scale(1, -1);
        ctx.translate(-width/2, -height/2);
        
        ctx.drawImage(frame, 0, 0, frame.width, frame.height, offsetX, offsetY, scaledWidth, scaledHeight);
        ctx.restore();
        
        const imageData = ctx.getImageData(0, 0, width, height);
        const data = imageData.data;
        
        for (let i = 0; i < data.length; i += 4) {
            const luminance = 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
            let value = luminance >= threshold ? 255 : 0;
            if (invertColors) value = 255 - value;
            data[i] = data[i + 1] = data[i + 2] = value;
            data[i + 3] = 255;
        }
        
        ctx.putImageData(imageData, 0, 0);
        
        const previewContainer = document.getElementById('framesPreview');
        while (previewContainer.firstChild) {
            previewContainer.removeChild(previewContainer.firstChild);
        }
        
        const framePreview = document.createElement('div');
        framePreview.className = 'frame-preview';
        canvas.style.borderRadius = '8px';
        canvas.style.boxShadow = '0 4px 20px rgba(0, 0, 0, 0.1)';
        framePreview.appendChild(canvas);
        previewContainer.appendChild(framePreview);
    }

    function resetPreview() {
        if (playInterval) {
            clearTimeout(playInterval);
            playInterval = null;
        }
        isPlaying = false;
        const playPauseButton = document.getElementById('playPause');
        if (playPauseButton) {
            playPauseButton.innerHTML = '<i class="bi bi-play-fill"></i> Play';
            playPauseButton.disabled = true;
        }
        
        const previewContainer = document.getElementById('framesPreview');
        if (previewContainer) previewContainer.innerHTML = '';
        
        gifFrames = [];
        frameDelays = [];
        currentFrameIndex = 0;
        updateFrameCounter();
        
        // Reset stats
        document.getElementById('frameCount').textContent = '0';
        document.getElementById('fileSize').textContent = '0 KB';
        
        const prevFrameBtn = document.getElementById('prevFrame');
        const nextFrameBtn = document.getElementById('nextFrame');
        if (prevFrameBtn) prevFrameBtn.disabled = true;
        if (nextFrameBtn) nextFrameBtn.disabled = true;
        
        const convertButton = document.getElementById('convertButton');
        const codeOutput = document.getElementById('codeOutput');
        if (convertButton) convertButton.disabled = true;
        if (codeOutput) codeOutput.textContent = '// Upload or select a GIF and click "Convert GIF" to see the result\n\n// Example output will appear here in C/C++ array format\n// Perfect for Arduino, ESP32, STM32, and other microcontrollers';
        
        const previewSection = document.getElementById('previewSection');
        if (previewSection) previewSection.style.display = 'none';
        
        if (gifPlayer) {
            gifPlayer = null;
        }
    }

    function processFrameArrays(gifFrames, width, height, drawMode, threshold, invertColors) {
        const frameArrays = [];
        
        for (let i = 0; i < gifFrames.length; i++) {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            
            canvas.width = width;
            canvas.height = height;
            
            const frame = gifFrames[i];
            const scaleMode = document.getElementById('scaleMode').value;
            const customScale = parseFloat(document.getElementById('customScale').value) || 1;
            const flipH = document.getElementById('flipHorizontal').checked;
            const flipV = document.getElementById('flipVertical').checked;
            const rotation = parseInt(document.getElementById('rotation').value);
            
            let scale = 1;
            let offsetX = 0;
            let offsetY = 0;
            
            if (scaleMode === 'fit') {
                const scaleX = width / frame.width;
                const scaleY = height / frame.height;
                scale = Math.min(scaleX, scaleY);
            } else if (scaleMode === 'fit_width') {
                scale = width / frame.width;
            } else if (scaleMode === 'fit_height') {
                scale = height / frame.height;
            } else if (scaleMode === 'custom') {
                scale = customScale;
            }
            
            const scaledWidth = frame.width * scale;
            const scaledHeight = frame.height * scale;
            offsetX = (width - scaledWidth) / 2;
            offsetY = (height - scaledHeight) / 2;
            
            ctx.save();
            ctx.translate(width/2, height/2);
            if (rotation) ctx.rotate(rotation * Math.PI / 180);
            if (flipH) ctx.scale(-1, 1);
            if (flipV) ctx.scale(1, -1);
            ctx.translate(-width/2, -height/2);
            
            ctx.drawImage(frame, 0, 0, frame.width, frame.height, offsetX, offsetY, scaledWidth, scaledHeight);
            ctx.restore();
            
            const imageData = ctx.getImageData(0, 0, width, height);
            const data = imageData.data;
            let bitmap = [];
            
            if (drawMode === 'horizontal') {
                for (let y = 0; y < height; y++) {
                    for (let x = 0; x < Math.ceil(width / 8); x++) {
                        let byte = 0;
                        for (let bit = 0; bit < 8; bit++) {
                            const pixelX = x * 8 + bit;
                            if (pixelX >= width) continue;
                            const pixelIndex = (y * width + pixelX) * 4;
                            const luminance = 0.299 * data[pixelIndex] + 0.587 * data[pixelIndex + 1] + 0.114 * data[pixelIndex + 2];
                            let isOn = luminance >= threshold;
                            if (invertColors) isOn = !isOn;
                            if (isOn) byte |= 1 << (7 - bit);
                        }
                        bitmap.push(byte);
                    }
                }
            } else if (drawMode === 'vertical') {
                for (let y = 0; y < Math.ceil(height / 8); y++) {
                    for (let x = 0; x < width; x++) {
                        let byte = 0;
                        for (let bit = 0; bit < 8; bit++) {
                            const pixelY = y * 8 + bit;
                            if (pixelY >= height) continue;
                            const pixelIndex = (pixelY * width + x) * 4;
                            const luminance = 0.299 * data[pixelIndex] + 0.587 * data[pixelIndex + 1] + 0.114 * data[pixelIndex + 2];
                            let isOn = luminance >= threshold;
                            if (invertColors) isOn = !isOn;
                            if (isOn) byte |= 1 << bit;
                        }
                        bitmap.push(byte);
                    }
                }
            } else if (drawMode === 'horizontal_bytes') {
                for (let y = 0; y < height; y++) {
                    for (let x = 0; x < width; x++) {
                        const pixelIndex = (y * width + x) * 4;
                        const luminance = 0.299 * data[pixelIndex] + 0.587 * data[pixelIndex + 1] + 0.114 * data[pixelIndex + 2];
                        let isOn = luminance >= threshold;
                        if (invertColors) isOn = !isOn;
                        bitmap.push(isOn ? 1 : 0);
                    }
                }
            }
            
            frameArrays.push(bitmap);
        }
        return frameArrays;
    }

    function convertGifToCode() {
        if (gifFrames.length === 0) {
            alert('Please upload a GIF first!');
            return;
        }
        
        const width = parseInt(document.getElementById('canvasWidth').value);
        const height = parseInt(document.getElementById('canvasHeight').value);
        const drawMode = document.getElementById('drawMode').value;
        const variableName = document.getElementById('variableName').value || 'myGif';
        const outputFormat = document.getElementById('outputFormat').value;
        const threshold = parseInt(document.getElementById('threshold').value);
        const invertColors = document.getElementById('invertColors').checked;
        
        const frameArrays = processFrameArrays(gifFrames, width, height, drawMode, threshold, invertColors);
        
        let code = "// GSN Creations - GIF to C/C++ Array Output\n";
        code += "// ============================================\n";
        code += "// Converted from GIF to C/C++ array for OLED/LCD displays\n";
        code += `// Frame count: ${gifFrames.length}\n`;
        code += `// Size: ${width}x${height} pixels\n`;
        code += `// Draw mode: ${drawMode}\n`;
        code += `// Threshold: ${threshold}\n`;
        code += `// Invert colors: ${invertColors ? 'Yes' : 'No'}\n`;
        code += `// Generated: ${new Date().toLocaleString()}\n`;
        code += "// ============================================\n\n";
        
        code += `#define ${variableName.toUpperCase()}_FRAME_COUNT ${gifFrames.length}\n`;
        code += `#define ${variableName.toUpperCase()}_WIDTH ${width}\n`;
        code += `#define ${variableName.toUpperCase()}_HEIGHT ${height}\n\n`;
        
        code += `// Frame display delays (milliseconds)\n`;
        code += `const uint16_t ${variableName}_delays[${variableName.toUpperCase()}_FRAME_COUNT] = {`;
        for (let i = 0; i < frameDelays.length; i++) {
            if (i > 0) code += ", ";
            code += frameDelays[i] || 100;
        }
        code += "};\n\n";
        
        let frameSizeBytes;
        if (drawMode === 'horizontal') {
            frameSizeBytes = Math.ceil(width / 8) * height;
        } else if (drawMode === 'vertical') {
            frameSizeBytes = width * Math.ceil(height / 8);
        } else {
            frameSizeBytes = Math.ceil((width * height) / 8);
        }
        
        if (outputFormat === 'arduino') {
            code += `// Image data - ${frameSizeBytes} bytes per frame\n`;
            code += `PROGMEM const uint8_t ${variableName}[${gifFrames.length}][${frameSizeBytes}] = {\n`;
        } else if (outputFormat === 'plain') {
            code += `// Image data - ${frameSizeBytes} bytes per frame\n`;
            code += `const uint8_t ${variableName}[${gifFrames.length}][${frameSizeBytes}] = {\n`;
        } else if (outputFormat === 'esp8266') {
            code += `// Image data - ${frameSizeBytes} bytes per frame\n`;
            code += `const uint8_t ${variableName}[${gifFrames.length}][${frameSizeBytes}] ICACHE_RODATA_ATTR = {\n`;
        }
        
        for (let i = 0; i < frameArrays.length; i++) {
            const frameData = frameArrays[i];
            code += "  {";
            for (let j = 0; j < frameData.length; j++) {
                if (j % 16 === 0) code += "\n    ";
                code += "0x" + frameData[j].toString(16).padStart(2, '0');
                if (j < frameData.length - 1) code += ", ";
            }
            code += "\n  }";
            if (i < frameArrays.length - 1) code += ",";
            code += "\n";
        }
        code += "};\n\n";
        
        // Add usage example
        code += "// ============================================\n";
        code += "// Usage Example for Arduino/ESP32:\n";
        code += "// ============================================\n";
        code += "/*\n";
        code += "void displayGifFrame(uint8_t frameIndex) {\n";
        code += "  for (int y = 0; y < " + variableName.toUpperCase() + "_HEIGHT; y++) {\n";
        code += "    for (int x = 0; x < " + variableName.toUpperCase() + "_WIDTH; x++) {\n";
        code += "      // Your display logic here\n";
        code += "      // Use " + variableName + "[frameIndex] data\n";
        code += "    }\n";
        code += "  }\n";
        code += "  delay(" + variableName + "_delays[frameIndex]);\n";
        code += "}\n";
        code += "*/\n";
        
        document.getElementById('codeOutput').textContent = code;
    }

    function saveAsHeader() {
        if (gifFrames.length === 0) {
            alert('Please upload a GIF first!');
            return;
        }
        
        const width = parseInt(document.getElementById('canvasWidth').value);
        const height = parseInt(document.getElementById('canvasHeight').value);
        const drawMode = document.getElementById('drawMode').value;
        const variableName = document.getElementById('variableName').value || 'myGif';
        const threshold = parseInt(document.getElementById('threshold').value);
        const invertColors = document.getElementById('invertColors').checked;
        
        const frameArrays = processFrameArrays(gifFrames, width, height, drawMode, threshold, invertColors);
        
        let headerContent = `#ifndef ${variableName.toUpperCase()}_H
#define ${variableName.toUpperCase()}_H

#include <stdint.h>
#include <pgmspace.h>

// GSN Creations - GIF to C/C++ Header Output
// ============================================
// Generated: ${new Date().toISOString().split('T')[0]}
// Frames: ${gifFrames.length}
// Size: ${width}x${height}
// Draw mode: ${drawMode}
// ============================================

#ifndef ANIMATED_GIF_DEFINED
#define ANIMATED_GIF_DEFINED
typedef struct {
    const uint8_t frame_count;
    const uint16_t width;
    const uint16_t height;
    const uint16_t* delays;
    const uint8_t (* frames)[${Math.ceil(width * height / 8)}];
} AnimatedGIF;
#endif

// Constants for ${variableName}
#define ${variableName.toUpperCase()}_FRAME_COUNT ${gifFrames.length}
#define ${variableName.toUpperCase()}_WIDTH ${width}
#define ${variableName.toUpperCase()}_HEIGHT ${height}

// Frame delays (milliseconds)
const uint16_t ${variableName}_delays[${variableName.toUpperCase()}_FRAME_COUNT] = {`;
        
        for (let i = 0; i < frameDelays.length; i++) {
            if (i > 0) headerContent += ", ";
            headerContent += frameDelays[i] || 100;
        }
        headerContent += `};

// Frame data
PROGMEM const uint8_t ${variableName}_frames[${variableName.toUpperCase()}_FRAME_COUNT][${Math.ceil(width * height / 8)}] = {
`;
        
        for (let i = 0; i < frameArrays.length; i++) {
            const frameData = frameArrays[i];
            headerContent += "  {";
            for (let j = 0; j < frameData.length; j++) {
                if (j % 16 === 0) headerContent += "\n    ";
                headerContent += "0x" + frameData[j].toString(16).padStart(2, '0');
                if (j < frameData.length - 1) headerContent += ", ";
            }
            headerContent += "\n  }";
            if (i < frameArrays.length - 1) headerContent += ",";
            headerContent += "\n";
        }
        headerContent += `};

// GIF object
const AnimatedGIF ${variableName}_gif = {
    .frame_count = ${variableName.toUpperCase()}_FRAME_COUNT,
    .width = ${variableName.toUpperCase()}_WIDTH,
    .height = ${variableName.toUpperCase()}_HEIGHT,
    .delays = ${variableName}_delays,
    .frames = ${variableName}_frames
};

#endif // ${variableName.toUpperCase()}_H
`;
        
        const blob = new Blob([headerContent], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${variableName}.h`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    function copyCode() {
        const codeOutput = document.getElementById('codeOutput');
        navigator.clipboard.writeText(codeOutput.textContent)
            .then(() => { 
                const btn = document.querySelector('[onclick="copyCode()"]');
                const originalHTML = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check"></i> <span class="d-none d-md-inline">Copied!</span>';
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-success');
                setTimeout(() => {
                    btn.innerHTML = originalHTML;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-primary');
                }, 2000);
            })
            .catch(err => { alert('Copy error: ' + err); });
    }

    function clearCode() {
        document.getElementById('codeOutput').textContent = '// Upload or select a GIF and click "Convert GIF" to see the result\n\n// Example output will appear here in C/C++ array format\n// Perfect for Arduino, ESP32, STM32, and other microcontrollers';
    }
    </script>
